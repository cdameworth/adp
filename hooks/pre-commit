#!/bin/bash
# ADP Pre-commit Hook
# Validates ADP session and registers commit intent with the ADP server.
#
# Environment Variables:
#   ADP_SESSION_ID      - Current ADP session identifier
#   ADP_SESSION_TOKEN   - Authentication token for ADP API
#   ADP_URL             - ADP server URL (default: http://localhost:8081)
#   ADP_BYPASS_TOKEN    - Hashed token for bypassing ADP checks (replaces ADP_BYPASS)
#   ADP_ALLOW_LEGACY_BYPASS - Set to "1" to allow legacy ADP_BYPASS env var
#   ADP_BYPASS          - Legacy bypass (requires ADP_ALLOW_LEGACY_BYPASS=1)
#   ADP_TIMEOUT         - Request timeout in seconds (default: 10)
#
# Exit Codes:
#   0 - Success, commit approved
#   1 - Failure, commit not approved or error occurred

set -e

# Configuration
ADP_URL="${ADP_URL:-http://localhost:8081}"
ADP_TIMEOUT="${ADP_TIMEOUT:-10}"

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

# Helper functions
log_error() {
    echo -e "${RED}[ADP] ERROR: $1${NC}" >&2
}

log_warn() {
    echo -e "${YELLOW}[ADP] WARNING: $1${NC}" >&2
}

log_success() {
    echo -e "${GREEN}[ADP] $1${NC}"
}

log_info() {
    echo "[ADP] $1"
}

# --- Bypass handling ---

# Token-verified bypass: ADP_BYPASS_TOKEN must match hash stored in .git/adp/bypass_hash
if [ -n "$ADP_BYPASS_TOKEN" ]; then
    BYPASS_HASH_FILE="$(git rev-parse --git-dir 2>/dev/null)/adp/bypass_hash"
    if [ -f "$BYPASS_HASH_FILE" ]; then
        STORED_HASH=$(cat "$BYPASS_HASH_FILE" 2>/dev/null)
        TOKEN_HASH=$(printf '%s' "$ADP_BYPASS_TOKEN" | shasum -a 256 | cut -d ' ' -f 1)
        if [ "$TOKEN_HASH" = "$STORED_HASH" ]; then
            log_info "Token-verified bypass: commit allowed"
            # Best-effort: log bypass event to ADP server
            if command -v curl &> /dev/null && [ -n "$ADP_SESSION_TOKEN" ]; then
                BYPASS_USER=$(git config user.email 2>/dev/null || echo "unknown")
                curl -sf --max-time 3 \
                    -X POST "$ADP_URL/v1/audit/bypass" \
                    -H "Authorization: Bearer $ADP_SESSION_TOKEN" \
                    -H "Content-Type: application/json" \
                    -d "{\"hook\":\"pre-commit\",\"user\":\"$BYPASS_USER\",\"method\":\"token\"}" \
                    2>/dev/null || true
            fi
            exit 0
        else
            log_error "Invalid bypass token"
            exit 1
        fi
    else
        log_error "Bypass token provided but no hash configured"
        log_info "Run: install.sh --configure-bypass to set up bypass tokens"
        exit 1
    fi
fi

# Legacy bypass: only if ADP_ALLOW_LEGACY_BYPASS is set
if [ -n "$ADP_BYPASS" ]; then
    if [ "$ADP_ALLOW_LEGACY_BYPASS" = "1" ]; then
        log_warn "Legacy bypass mode (deprecated). Migrate to ADP_BYPASS_TOKEN."
        # Best-effort: log legacy bypass event
        if command -v curl &> /dev/null && [ -n "$ADP_SESSION_TOKEN" ]; then
            BYPASS_USER=$(git config user.email 2>/dev/null || echo "unknown")
            curl -sf --max-time 3 \
                -X POST "$ADP_URL/v1/audit/bypass" \
                -H "Authorization: Bearer $ADP_SESSION_TOKEN" \
                -H "Content-Type: application/json" \
                -d "{\"hook\":\"pre-commit\",\"user\":\"$BYPASS_USER\",\"method\":\"legacy\"}" \
                2>/dev/null || true
        fi
        exit 0
    else
        log_error "ADP_BYPASS is no longer supported. Use ADP_BYPASS_TOKEN instead."
        log_info "Set ADP_ALLOW_LEGACY_BYPASS=1 to temporarily re-enable legacy bypass."
        log_info "Run: install.sh --configure-bypass to set up token-based bypass."
        exit 1
    fi
fi

# --- Normal ADP validation ---

# Check for required environment variables
if [ -z "$ADP_SESSION_ID" ]; then
    log_error "No active ADP session found."
    log_info "Start a session with: adp session start"
    log_info "Or set ADP_BYPASS_TOKEN for human commits"
    exit 1
fi

if [ -z "$ADP_SESSION_TOKEN" ]; then
    log_error "No ADP session token found."
    log_info "Ensure you started a session with: adp session start"
    exit 1
fi

# Check if curl is available
if ! command -v curl &> /dev/null; then
    log_error "curl is required but not installed"
    exit 1
fi

# Check if jq is available
if ! command -v jq &> /dev/null; then
    log_error "jq is required but not installed"
    exit 1
fi

# Get staged files
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACMR)

if [ -z "$STAGED_FILES" ]; then
    log_info "No staged files, skipping ADP validation"
    exit 0
fi

# Convert staged files to JSON array
FILES_JSON=$(echo "$STAGED_FILES" | jq -R -s -c 'split("\n") | map(select(length > 0))')

# Get commit message if available
COMMIT_MSG=""
if [ -f ".git/COMMIT_EDITMSG" ]; then
    COMMIT_MSG=$(cat .git/COMMIT_EDITMSG 2>/dev/null | head -n 1)
fi

# Prepare the request payload
REQUEST_PAYLOAD=$(jq -n \
    --arg session_id "$ADP_SESSION_ID" \
    --argjson files "$FILES_JSON" \
    --arg message "$COMMIT_MSG" \
    '{
        session_id: $session_id,
        files: $files,
        message: $message
    }')

log_info "Validating commit with ADP server..."

# Make the API call to prepare commit
RESPONSE=$(curl -sf \
    --max-time "$ADP_TIMEOUT" \
    -X POST "$ADP_URL/v1/commits/prepare" \
    -H "Authorization: Bearer $ADP_SESSION_TOKEN" \
    -H "Content-Type: application/json" \
    -d "$REQUEST_PAYLOAD" 2>/dev/null) || {
    log_error "Failed to connect to ADP server at $ADP_URL"
    log_info "Check if the ADP server is running"
    exit 1
}

# Parse the response
APPROVED=$(echo "$RESPONSE" | jq -r '.approved // false')
COMMIT_TOKEN=$(echo "$RESPONSE" | jq -r '.commit_token // empty')
REASON=$(echo "$RESPONSE" | jq -r '.reason // "Unknown reason"')

if [ "$APPROVED" != "true" ]; then
    log_error "Commit not approved"
    log_info "Reason: $REASON"

    # Check if this is a sensitive file issue
    if echo "$REASON" | grep -qi "sensitive"; then
        log_warn "Sensitive files detected. Request manual approval:"
        log_info "  adp approve commit --session $ADP_SESSION_ID"
    fi

    exit 1
fi

# Store commit token for post-commit verification
if [ -n "$COMMIT_TOKEN" ]; then
    echo "$COMMIT_TOKEN" > .git/ADP_COMMIT_TOKEN
    export ADP_COMMIT_TOKEN="$COMMIT_TOKEN"
fi

log_success "Commit approved"
log_info "Token: ${COMMIT_TOKEN:0:16}..."
exit 0
