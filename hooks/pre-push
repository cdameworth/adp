#!/bin/bash
# ADP Pre-push Hook
# Verifies that all commits being pushed have audit trails in ADP.
#
# Environment Variables:
#   ADP_SESSION_TOKEN   - Authentication token for ADP API
#   ADP_URL             - ADP server URL (default: http://localhost:8081)
#   ADP_BYPASS_TOKEN    - Hashed token for bypassing ADP checks
#   ADP_ALLOW_LEGACY_BYPASS - Set to "1" to allow legacy ADP_BYPASS env var
#   ADP_BYPASS          - Legacy bypass (requires ADP_ALLOW_LEGACY_BYPASS=1)
#   ADP_TIMEOUT         - Request timeout in seconds (default: 10)
#   ADP_MODE            - When "standalone", use adp-mcp binary directly via stdin
#
# Exit Codes:
#   0 - Success, all commits verified
#   1 - Failure, one or more commits missing audit trail

set -e

# Configuration
ADP_URL="${ADP_URL:-http://localhost:8081}"
ADP_TIMEOUT="${ADP_TIMEOUT:-10}"

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

# Helper functions
log_error() {
    echo -e "${RED}[ADP] ERROR: $1${NC}" >&2
}

log_warn() {
    echo -e "${YELLOW}[ADP] WARNING: $1${NC}" >&2
}

log_success() {
    echo -e "${GREEN}[ADP] $1${NC}"
}

log_info() {
    echo "[ADP] $1"
}

# --- Bypass handling ---

# Token-verified bypass
if [ -n "$ADP_BYPASS_TOKEN" ]; then
    BYPASS_HASH_FILE="$(git rev-parse --git-dir 2>/dev/null)/adp/bypass_hash"
    if [ -f "$BYPASS_HASH_FILE" ]; then
        STORED_HASH=$(cat "$BYPASS_HASH_FILE" 2>/dev/null)
        TOKEN_HASH=$(printf '%s' "$ADP_BYPASS_TOKEN" | shasum -a 256 | cut -d ' ' -f 1)
        if [ "$TOKEN_HASH" = "$STORED_HASH" ]; then
            log_info "Token-verified bypass: push allowed"
            # Best-effort: log bypass event
            if command -v curl &> /dev/null && [ -n "$ADP_SESSION_TOKEN" ]; then
                BYPASS_USER=$(git config user.email 2>/dev/null || echo "unknown")
                curl -sf --max-time 3 \
                    -X POST "$ADP_URL/v1/audit/bypass" \
                    -H "Authorization: Bearer $ADP_SESSION_TOKEN" \
                    -H "Content-Type: application/json" \
                    -d "{\"hook\":\"pre-push\",\"user\":\"$BYPASS_USER\",\"method\":\"token\"}" \
                    2>/dev/null || true
            fi
            exit 0
        else
            log_error "Invalid bypass token"
            exit 1
        fi
    else
        log_error "Bypass token provided but no hash configured"
        log_info "Run: install.sh --configure-bypass to set up bypass tokens"
        exit 1
    fi
fi

# Legacy bypass
if [ -n "$ADP_BYPASS" ]; then
    if [ "$ADP_ALLOW_LEGACY_BYPASS" = "1" ]; then
        log_warn "Legacy bypass mode (deprecated). Migrate to ADP_BYPASS_TOKEN."
        exit 0
    else
        log_error "ADP_BYPASS is no longer supported. Use ADP_BYPASS_TOKEN instead."
        log_info "Set ADP_ALLOW_LEGACY_BYPASS=1 to temporarily re-enable legacy bypass."
        exit 1
    fi
fi

# --- Standalone MCP mode ---

# When ADP_MODE=standalone, call adp-mcp directly via stdin for verification
verify_commit_standalone() {
    local commit_sha=$1
    local adp_mcp_bin="${ADP_MCP_BIN:-adp-mcp}"

    if ! command -v "$adp_mcp_bin" &> /dev/null; then
        return 1
    fi

    local init_msg='{"jsonrpc":"2.0","id":1,"method":"initialize","params":{"protocolVersion":"2024-11-05","capabilities":{},"clientInfo":{"name":"pre-push","version":"1.0"}}}'
    local verify_msg="{\"jsonrpc\":\"2.0\",\"id\":2,\"method\":\"tools/call\",\"params\":{\"name\":\"adp_verify_commit\",\"arguments\":{\"commit_sha\":\"$commit_sha\"}}}"

    local response
    response=$(printf '%s\n%s\n' "$init_msg" "$verify_msg" | "$adp_mcp_bin" 2>/dev/null | tail -n 1)

    if echo "$response" | grep -q '"verified".*true'; then
        return 0
    fi
    return 1
}

# --- Normal verification ---

# Check if curl is available
if ! command -v curl &> /dev/null; then
    log_error "curl is required but not installed"
    exit 1
fi

# Check if jq is available
if ! command -v jq &> /dev/null; then
    log_error "jq is required but not installed"
    exit 1
fi

# Read the push information from stdin
FAILED_COMMITS=()
VERIFIED_COUNT=0
TOTAL_COUNT=0

while read local_ref local_sha remote_ref remote_sha; do
    # Skip branch deletions
    if [ "$local_sha" = "0000000000000000000000000000000000000000" ]; then
        continue
    fi

    # Determine commits to check
    if [ "$remote_sha" = "0000000000000000000000000000000000000000" ]; then
        # New branch - check all commits
        COMMITS=$(git rev-list "$local_sha" --not --remotes)
    else
        # Existing branch - check new commits only
        COMMITS=$(git rev-list "$remote_sha..$local_sha")
    fi

    if [ -z "$COMMITS" ]; then
        continue
    fi

    log_info "Verifying commits for $local_ref..."

    for commit in $COMMITS; do
        TOTAL_COUNT=$((TOTAL_COUNT + 1))

        # Get commit info for better error messages
        COMMIT_MSG=$(git log --format="%s" -n 1 "$commit")
        COMMIT_SHORT="${commit:0:8}"

        # Try standalone MCP mode first
        if [ "$ADP_MODE" = "standalone" ]; then
            if verify_commit_standalone "$commit"; then
                VERIFIED_COUNT=$((VERIFIED_COUNT + 1))
                continue
            fi
            FAILED_COMMITS+=("$commit:standalone-failed")
            log_error "Commit $COMMIT_SHORT not verified (standalone mode)"
            log_info "  Message: $COMMIT_MSG"
            continue
        fi

        # Verify commit with ADP server
        RESPONSE=$(curl -sf \
            --max-time "$ADP_TIMEOUT" \
            -X POST "$ADP_URL/v1/commits/verify" \
            -H "Authorization: Bearer ${ADP_SESSION_TOKEN:-}" \
            -H "Content-Type: application/json" \
            -d "{\"commit_sha\": \"$commit\"}" 2>/dev/null) || {
            log_warn "Could not verify commit $COMMIT_SHORT (server unreachable)"
            FAILED_COMMITS+=("$commit:unreachable")
            continue
        }

        VERIFIED=$(echo "$RESPONSE" | jq -r '.verified // false')
        REASON=$(echo "$RESPONSE" | jq -r '.reason // empty')

        if [ "$VERIFIED" = "true" ]; then
            VERIFIED_COUNT=$((VERIFIED_COUNT + 1))
        else
            FAILED_COMMITS+=("$commit:$REASON")
            log_error "Commit $COMMIT_SHORT missing audit trail"
            log_info "  Message: $COMMIT_MSG"
            if [ -n "$REASON" ]; then
                log_info "  Reason: $REASON"
            fi
        fi
    done
done

# Report results
if [ $TOTAL_COUNT -eq 0 ]; then
    log_info "No commits to verify"
    exit 0
fi

log_info "Verified $VERIFIED_COUNT of $TOTAL_COUNT commits"

if [ ${#FAILED_COMMITS[@]} -gt 0 ]; then
    log_error "Push blocked: ${#FAILED_COMMITS[@]} commit(s) missing audit trail"
    echo ""
    log_info "To resolve this issue:"
    log_info "  1. Ensure commits are made with an active ADP session"
    log_info "  2. Or use ADP_BYPASS_TOKEN for legitimate non-agent commits"
    log_info "  3. Or contact your admin to retroactively verify commits"
    exit 1
fi

log_success "All commits verified"
exit 0
