#!/bin/bash
# ADP Post-commit Hook
# Registers the commit SHA with the ADP server after a successful commit.
#
# Environment Variables:
#   ADP_SESSION_ID      - Current ADP session identifier
#   ADP_SESSION_TOKEN   - Authentication token for ADP API
#   ADP_URL             - ADP server URL (default: http://localhost:8081)
#   ADP_BYPASS_TOKEN    - Hashed token for bypassing ADP checks
#   ADP_ALLOW_LEGACY_BYPASS - Set to "1" to allow legacy ADP_BYPASS env var
#   ADP_BYPASS          - Legacy bypass (requires ADP_ALLOW_LEGACY_BYPASS=1)
#   ADP_TIMEOUT         - Request timeout in seconds (default: 10)
#
# This hook is informational and does not block commits.

# Configuration
ADP_URL="${ADP_URL:-http://localhost:8081}"
ADP_TIMEOUT="${ADP_TIMEOUT:-10}"

# Colors for output
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

log_warn() {
    echo -e "${YELLOW}[ADP] WARNING: $1${NC}" >&2
}

log_success() {
    echo -e "${GREEN}[ADP] $1${NC}"
}

log_info() {
    echo "[ADP] $1"
}

# --- Bypass handling ---

# Token-verified bypass
if [ -n "$ADP_BYPASS_TOKEN" ]; then
    BYPASS_HASH_FILE="$(git rev-parse --git-dir 2>/dev/null)/adp/bypass_hash"
    if [ -f "$BYPASS_HASH_FILE" ]; then
        STORED_HASH=$(cat "$BYPASS_HASH_FILE" 2>/dev/null)
        TOKEN_HASH=$(printf '%s' "$ADP_BYPASS_TOKEN" | shasum -a 256 | cut -d ' ' -f 1)
        if [ "$TOKEN_HASH" = "$STORED_HASH" ]; then
            exit 0
        fi
    fi
    exit 0
fi

# Legacy bypass
if [ -n "$ADP_BYPASS" ]; then
    if [ "$ADP_ALLOW_LEGACY_BYPASS" = "1" ]; then
        exit 0
    fi
    # Not blocking on post-commit even if legacy bypass is disabled
    exit 0
fi

# Check for session
if [ -z "$ADP_SESSION_ID" ]; then
    exit 0
fi

# Get the commit token from pre-commit hook
COMMIT_TOKEN=""
if [ -f ".git/ADP_COMMIT_TOKEN" ]; then
    COMMIT_TOKEN=$(cat .git/ADP_COMMIT_TOKEN)
    rm -f .git/ADP_COMMIT_TOKEN
fi

if [ -z "$COMMIT_TOKEN" ]; then
    log_warn "No commit token found, skipping registration"
    exit 0
fi

# Get the commit SHA
COMMIT_SHA=$(git rev-parse HEAD)

# Check if curl and jq are available
if ! command -v curl &> /dev/null || ! command -v jq &> /dev/null; then
    log_warn "curl and jq are required for post-commit registration"
    exit 0
fi

# Register the commit with ADP
RESPONSE=$(curl -sf \
    --max-time "$ADP_TIMEOUT" \
    -X POST "$ADP_URL/v1/commits/register" \
    -H "Authorization: Bearer $ADP_SESSION_TOKEN" \
    -H "Content-Type: application/json" \
    -d "{
        \"commit_token\": \"$COMMIT_TOKEN\",
        \"commit_sha\": \"$COMMIT_SHA\"
    }" 2>/dev/null) || {
    log_warn "Failed to register commit with ADP server"
    exit 0
}

STATUS=$(echo "$RESPONSE" | jq -r '.status // empty')

if [ "$STATUS" = "committed" ] || [ "$STATUS" = "registered" ]; then
    log_success "Commit registered: ${COMMIT_SHA:0:8}"
else
    log_warn "Unexpected response from ADP server"
fi

exit 0
