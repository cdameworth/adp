# ═══════════════════════════════════════════════
# ADP .gitignore
# ═══════════════════════════════════════════════

# ── Go build artifacts ──────────────────────────
# Compiled binaries (built via go build ./cmd/*)
/adp-cli
/adp-mcp
/adp-server
bin/
dist/

# Go test/coverage output
coverage.out
coverage.html
*.test
*.prof
cpu.prof
mem.prof

# Go workspace files
go.work
go.work.sum

# ── Database files ──────────────────────────────
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# ── Environment and secrets ─────────────────────
.env
.env.*
!.env.example
*.pem
*.key
*.crt
*.p12
*.pfx
credentials.json
service_account*.json
secrets.yaml
secrets.json

# ── IDE and editor files ────────────────────────
.idea/
.vscode/
*.swp
*.swo
*~
*.sublime-project
*.sublime-workspace
.project
.classpath
.settings/

# ── OS-generated files ──────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini

# ── Node.js / Frontend (web/) ───────────────────
web/node_modules/
web/.next/
web/out/
web/.turbo/
web/.env
web/.env.local

# ── Backstage plugins ──────────────────────────
backstage-plugins/node_modules/
backstage-plugins/dist/

# ── Docker ──────────────────────────────────────
# Local docker volume data (if mounted)
.docker-data/

# ── Logs and temp files ─────────────────────────
*.log
*.tmp
*.temp
tmp/
temp/

# ── OPA bundles (compiled policy) ───────────────
*.tar.gz
policies/*.bundle

# ── Helm packaging output ───────────────────────
deploy/helm/adp/charts/
deploy/helm/adp/*.tgz

# Python
__pycache__/
*.pyc
